# ============================================================
#  Sebna production configuration  (used by docker-compose.yml)
#  NEVER commit this file. Keep a private backup of it.
# ============================================================

# --- Domain / HTTPS ---
DOMAIN=sebna.et

# Path to the frontend repo (nahom4426/sebna), relative to this deploy/ folder
FRONTEND_DIR=../../Sebna_FE
# Email for Let's Encrypt certificate expiry notices (optional but recommended)
ACME_EMAIL=admin@sebna.et

# --- Database ---
POSTGRES_USER=sebna
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=sebna

# --- JWT (Base64, >= 32 bytes. Generate: openssl rand -base64 48) ---
JWT_SECRET=CHANGE_ME_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# --- JVM memory (75% of container RAM by default) ---
# JAVA_OPTS=-Xms256m -Xmx1g

# --- Mail (Gmail needs an App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SENDER_NAME=Sebna

# --- AfroMessage SMS ---
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=

# --- Chapa payment ---
PAYMENT_RETURN_URL=https://sebna.et/payment
PAYMENT_API_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=https://sebna.et/api/sebna/payment/checkout
PAYMENT_CHAPA_REQUEST_URL=
CHAPA_DIRECT_PAY_URL=
CHAPA_SECRET_KEY=

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_BUCKET=pf-car-images
